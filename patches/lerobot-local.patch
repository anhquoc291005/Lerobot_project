+def apply_manual_recording_control(control: str, events: dict) -> None:
+    """Space starts/saves an episode, Q discards it, Escape saves/exits the session."""
+    key = control.lower()
+    phase = events.get("phase", "waiting")
+    if key == "esc":
+        events["stop_recording"] = True
+        events["exit_early"] = True
+    elif key == "space" and phase == "waiting":
+        events["start_episode"] = True
+        events["exit_early"] = True
+        events["phase"] = "starting"
+    elif key in ("q", "left", "r") and phase == "recording":
+        events["rerecord_episode"] = True
+        events["exit_early"] = True
+        events["phase"] = "cancelling"
+    elif key in ("space", "right", "n") and phase == "recording":
+        events["exit_early"] = True
+        events["phase"] = "saving"
+
+
+def init_manual_recording_listener():
+    """Create manual episode controls using the existing X11/terminal backends."""
+    events = {
+        "exit_early": False,
+        "rerecord_episode": False,
+        "stop_recording": False,
+        "start_episode": False,
+        "phase": "waiting",
+    }
+    listener = create_key_listener(
+        lambda key: apply_manual_recording_control(key, events),
+        controls_help="Space=start/save episode, Q=cancel episode, Esc=save and exit",
+    )
+    return listener, events
+
