+@EnvConfig.register_subclass("so101_stack_3_blocks")
+@dataclass
+class SO101Stack3BlocksEnv(EnvConfig):
+    """Môi trường mô phỏng SO-101 Stack 3 Blocks (hộp ngẫu nhiên theo ô lưới 5x7).
+
+    Được thiết kế đồng bộ hoàn toàn với dữ liệu thực nghiệm:
+    - 3 khối hộp 30x30x30 mm: Black (đáy), Green (giữa), Blue (trên cùng).
+    - Vị trí random: 1 ô trái, 1 ô phải, 1 ô giữa theo ô lưới camera top.
+    - Cặp camera kép 640x480: top_cam và front_cam (gain 1.2).
+    - Tần số: 30 FPS.
+    - Đơn vị state & action: Độ (Degrees) tương thích trực tiếp mô hình ACT.
+    """
+
+    task: str | None = "SO101Stack3Blocks-v0"
+    fps: int = 30
+    episode_length: int = 1800
+    obs_type: str = "pixels_agent_pos"
+    observation_height: int = 480
+    observation_width: int = 640
+    render_mode: str = "rgb_array"
+    xml_path: str | None = None
+    features: dict[str, PolicyFeature] = field(default_factory=dict)
+    features_map: dict[str, str] = field(default_factory=dict)
+
+    def __post_init__(self):
+        self.features = {
+            ACTION: PolicyFeature(type=FeatureType.ACTION, shape=(6,)),
+            "agent_pos": PolicyFeature(type=FeatureType.STATE, shape=(6,)),
+            "pixels/top": PolicyFeature(
+                type=FeatureType.VISUAL, shape=(self.observation_height, self.observation_width, 3)
+            ),
+            "pixels/front": PolicyFeature(
+                type=FeatureType.VISUAL, shape=(self.observation_height, self.observation_width, 3)
+            ),
+        }
+        default_features_map = {
+            ACTION: ACTION,
+            "agent_pos": OBS_STATE,
+            "top": f"{OBS_IMAGE}.top",
+            "pixels/top": f"{OBS_IMAGES}.top",
+            "front": f"{OBS_IMAGE}.front",
+            "pixels/front": f"{OBS_IMAGES}.front",
+        }
+        self.features_map = {**default_features_map, **self.features_map}
+
+    @property
+    def gym_kwargs(self) -> dict:
+        return {
+            "xml_path": self.xml_path,
+            "max_episode_steps": self.episode_length,
+            "render_mode": self.render_mode,
+            "image_height": self.observation_height,
+            "image_width": self.observation_width,
+            "fps": self.fps,
+        }
+
+    def create_envs(self, n_envs: int, use_async_envs: bool = False):
+        from lerobot.envs.so101 import create_so101_stack_3_blocks_envs
+
+        return create_so101_stack_3_blocks_envs(self, n_envs=n_envs, use_async_envs=use_async_envs)
+
+
+@EnvConfig.register_subclass("so101")
+@dataclass
+class SO101Env(SO101Stack3BlocksEnv):
+    """Alias cho so101_stack_3_blocks."""
+    pass
