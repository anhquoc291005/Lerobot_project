+"""Display recording state independently of camera images and dataset features."""
+
+import logging
+
+from .import_utils import require_package
+
+RECORDING_STATUS_PATH = "recording_status"
+
+
+def report_recording_status(
+    recording: bool,
+    episode_index: int,
+    *,
+    display_mode: str | None = None,
+    detail: str = "",
+) -> None:
+    title = "ĐANG THU DATA" if recording else "CHƯA THU DATA"
+    logging.info("%s | Episode %s | %s", title, episode_index, detail)
+    if display_mode != "rerun":
+        return
+    require_package("rerun-sdk", extra="viz", import_name="rerun")
+    import rerun as rr
+
+    indicator = "🔴" if recording else "🟢"
+    document = (
+        f"# {indicator} {title}\n\n"
+        f"**Episode {episode_index}** — {detail}\n\n"
+        "**Space:** bắt đầu / kết thúc và lưu · **Q:** hủy episode · **Esc:** lưu và thoát"
+    )
+    rr.log(
+        RECORDING_STATUS_PATH,
+        rr.TextDocument(document, media_type=rr.MediaType.MARKDOWN),
+        static=True,
+    )
diff --git a/src/lerobot/utils/workspace_boundary.py b/src/lerobot/utils/workspace_boundary.py
new file mode 100644
index 00000000..7be53e9c
--- /dev/null
+++ b/src/lerobot/utils/workspace_boundary.py
@@ -0,0 +1,96 @@
+"""Camera-space workspace guides, logged separately from recorded image pixels."""
+
+import json
+import logging
+from pathlib import Path
+
+import numpy as np
+
+from .import_utils import require_package
+
+
+class WorkspaceBoundaryOverlay:
+    """A visual guide only: these polygons do not constrain robot motion."""
+
+    def __init__(self, path: str | Path):
+        self.path = Path(path)
+        config = json.loads(self.path.read_text())
+        cameras = config.get("cameras")
+        if not isinstance(cameras, dict) or not cameras:
+            raise ValueError("Workspace boundary JSON must contain a nonempty 'cameras' object.")
+        self.boundaries = {}
+        for camera, boundary in cameras.items():
+            points = np.asarray(boundary["points"], dtype=np.float32)
+            if (
+                points.ndim != 2
+                or points.shape[1] != 2
+                or len(points) < 3
+                or not np.isfinite(points).all()
+                or np.any(points < 0)
+                or np.any(points > 1)
+            ):
+                raise ValueError(f"Boundary '{camera}' needs at least 3 normalized [x, y] points in [0, 1].")
+            area = np.sum(points[:, 0] * np.roll(points[:, 1], -1)) - np.sum(
+                points[:, 1] * np.roll(points[:, 0], -1)
+            )
+            if abs(area) < 1e-6:
+                raise ValueError(f"Boundary '{camera}' has zero area.")
+            color = np.asarray(boundary.get("color", [70, 255, 130]))
+            if (
+                color.shape != (3,)
+                or not np.isfinite(color).all()
+                or np.any(color < 0)
+                or np.any(color > 255)
+            ):
+                raise ValueError(f"Boundary '{camera}' color must be three RGB values in [0, 255].")
+            self.boundaries[camera] = {
+                "points": points,
+                "color": color.astype(np.uint8),
+                "label": boundary.get("label"),
+            }
+        self._logged_shapes = {}
+        self._checked_cameras = False
+
+    def points_for_image(self, camera: str, width: int, height: int) -> np.ndarray:
+        """Scale normalized points to the current image size without modifying the config."""
+        return self.boundaries[camera]["points"] * np.array([width - 1, height - 1])
+
+    def log_rerun(self, observation: dict | None) -> None:
+        if not observation:
+            return
+        require_package("rerun-sdk", extra="viz", import_name="rerun")
+        import rerun as rr
+
+        seen = set()
+        for key, frame in observation.items():
+            camera = str(key).rsplit(".", 1)[-1]
+            if camera not in self.boundaries or not isinstance(frame, np.ndarray) or frame.ndim != 3:
+                continue
+            seen.add(camera)
+            if frame.shape[0] in (1, 3, 4) and frame.shape[-1] not in (1, 3, 4):
+                height, width = frame.shape[1:]
+            else:
+                height, width = frame.shape[:2]
+            entity = str(key) if str(key).startswith("observation.") else f"observation.{key}"
+            if self._logged_shapes.get(entity) == (height, width):
+                continue
+            boundary = self.boundaries[camera]
+            points = self.points_for_image(camera, width, height)
+            closed = np.concatenate([points, points[:1]])
+            rr.log(
+                f"{entity}/workspace_boundary",
+                rr.LineStrips2D(
+                    [closed],
+                    colors=[boundary["color"]],
+                    radii=rr.Radius.ui_points(2.5),
+                    labels=[boundary["label"]] if boundary["label"] else None,
+                    show_labels=bool(boundary["label"]),
+                    draw_order=30,
+                ),
+                static=True,
+            )
+            self._logged_shapes[entity] = (height, width)
+        if not self._checked_cameras:
+            for camera in self.boundaries.keys() - seen:
+                logging.warning("Workspace guide camera '%s' is missing from displayed images.", camera)
+            self._checked_cameras = True
